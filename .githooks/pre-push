#!/usr/bin/env sh
# Block the push unless formatting, lint, type check and tests all pass.
# Enable once per clone: git config core.hooksPath .githooks
# Bypass in an emergency: git push --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: ruff format" && uvx ruff format --check
echo "pre-push: ruff" && uvx ruff check
echo "pre-push: pyrefly" && uvx pyrefly check
echo "pre-push: pytest" && uv run pytest -q
